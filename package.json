{
  "name": "glazelab-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "The Glazelab web app: a ceramic glaze library, stock tracker and glaze-combination notebook",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run format:check && npm run check && npm run test && vite build",
    "check": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-ts",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:smoke": "playwright test -c e2e/playwright.config.ts --grep @smoke",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "e2e:firefox-update": "node e2e/firefox/update-lifecycle.mjs",
    "e2e:walkthrough": "GLAZELAB_E2E_RUN=walkthrough/run playwright test -c e2e/walkthrough.config.ts",
    "e2e:videos": "GLAZELAB_E2E_RUN=videos-run playwright test -c e2e/walkthrough/videos.config.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "barcode-detector": "3.2.3",
    "onnxruntime-web": "1.31.1",
    "svelte": "5.57.3",
    "svelte-i18n": "^4.0.1",
    "tesseract.js": "7.0.0",
    "workbox-window": "7.4.1",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup-plugin-license": "3.7.1",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "5.0.4"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    },
    "svelte-i18n": {
      "esbuild": "0.28.1"
    }
  }
}
